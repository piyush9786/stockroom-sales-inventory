# Copy to .env and replace these local placeholders. Never commit .env.
SECRET_KEY=replace-with-a-random-value-at-least-32-characters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sales_app
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=sales_inventory
# A separate, disposable database used ONLY by integration tests.
TEST_DB_NAME=sales_inventory_test
SESSION_COOKIE_SECURE=false
# Optional shop details printed on sales bills. Leave address/phone empty if unused.
SHOP_NAME=The Trading Store
SHOP_ADDRESS=
SHOP_PHONE=
